# Postgres connection string used by drizzle-orm (lib/db.ts) and drizzle-kit.
# Leave unset to use the embedded database stored in .data/ (fine for one server
# or local development; serverless hosts such as Vercel need a real Postgres).
DATABASE_URL=postgres://user:password@localhost:5432/harry_advocates

# Owner admin account for the /admin login gate (app/api/admin/login/route.ts).
# More admins and editors can be added from Admin > Team & permissions.
ADMIN_NAME=Harry Arunda
ADMIN_EMAIL=admin@harryadvocates.co.ke
ADMIN_PASSWORD=change-me

# Secret used to sign the admin session cookie (lib/auth.ts). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=replace-with-a-long-random-string
